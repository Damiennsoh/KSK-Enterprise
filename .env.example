# ============================================================
# KSK Enterprise - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── Supabase Configuration ──────────────────────────────────
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Paystack Configuration ──────────────────────────────────
# Get these from your Paystack Dashboard > Settings > API Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ─── Application ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="KSK Enterprise"
NEXT_PUBLIC_COMPANY_PHONE="0242070938"
NEXT_PUBLIC_COMPANY_PHONE_ALT="0202348762"
NEXT_PUBLIC_COMPANY_LOCATION="Wa, Upper West Region, Ghana"

# ─── Admin Configuration ─────────────────────────────────────
# Comma-separated list of emails that will be granted admin role
ADMIN_EMAILS=admin@kskenterprise.com,your-email@example.com
